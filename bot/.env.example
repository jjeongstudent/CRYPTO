# Copy to bot/.env and fill in. Never commit the real file.

# ---- Required -------------------------------------------------------------
# A Base mainnet HTTPS RPC. A paid endpoint (Alchemy, QuickNode, your own node) is strongly
# recommended: the bot reads logs every block and public endpoints rate-limit hard.
RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# ---- Trading (leave PRIVATE_KEY/EXECUTOR_ADDRESS empty to paper-trade) -----
# The executor's OPERATOR hot key. It only needs ETH for gas; it cannot withdraw inventory.
PRIVATE_KEY=
# Address printed by contracts/script/Deploy.s.sol.
EXECUTOR_ADDRESS=
# Nothing is ever sent unless this is explicitly false.
DRY_RUN=true

# ---- Strategy ---------------------------------------------------------------
# Max WETH per trade (also capped by what the executor holds).
MAX_TRADE_ETH=1
# Minimum profit AFTER gas, L1 data fee and priority bid.
MIN_PROFIT_ETH=0.00002
# Share of expected profit offered as priority fee. Higher wins more races, keeps less per win.
BID_PERCENT=30
# 2 = direct DEX-vs-DEX, 3 = adds triangles (e.g. WETH -> USDC -> TOKEN -> WETH).
MAX_HOPS=3
# Ignore pools with less WETH than this.
MIN_POOL_WETH=0.5
MAX_TX_PER_BLOCK=2

# ---- Discovery --------------------------------------------------------------
# Scan this many recent blocks (~2s each) of swaps to find active long-tail tokens. 0 disables.
DISCOVER_BLOCKS=900
MAX_SPOKES=300
# Comma-separated token addresses to always track.
EXTRA_TOKENS=
# Comma-separated DEX names to skip: uniswap-v2,sushiswap-v2,pancakeswap-v2,baseswap,aerodrome
DISABLE_DEXES=

# ---- Plumbing ---------------------------------------------------------------
RESYNC_EVERY_BLOCKS=150
POLL_MS=200
LOG_LEVEL=info
TRADE_LOG=logs/trades.jsonl
