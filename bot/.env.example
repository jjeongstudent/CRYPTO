# Copy to bot/.env and fill in. Never commit the real file.

# ---- Required -------------------------------------------------------------
# A Base mainnet HTTPS RPC. A paid endpoint (Alchemy, QuickNode, your own node) is strongly
# recommended: the bot reads logs every block and public endpoints rate-limit hard.
RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# ---- Trading (leave PRIVATE_KEY/EXECUTOR_ADDRESS empty to paper-trade) -----
# The executor's OPERATOR hot key. It only needs ETH for gas; it cannot withdraw inventory.
PRIVATE_KEY=
# Address printed by contracts/script/Deploy.s.sol.
EXECUTOR_ADDRESS=
# Nothing is ever sent unless this is explicitly false.
DRY_RUN=true

# ---- Strategy ---------------------------------------------------------------
# Max WETH per trade (also capped by what the executor holds).
MAX_TRADE_ETH=1
# Minimum profit AFTER gas, L1 data fee and priority bid.
MIN_PROFIT_ETH=0.00002
# Share of expected profit offered as priority fee. Higher wins more races, keeps less per win.
BID_PERCENT=30
# 2 = direct DEX-vs-DEX, 3 = adds triangles (e.g. WETH -> USDC -> TOKEN -> WETH).
MAX_HOPS=3
# Ignore pools with less WETH than this.
MIN_POOL_WETH=0.5
MAX_TX_PER_BLOCK=2

# ---- Speed ------------------------------------------------------------------
# Base Flashblocks: react to 200ms pre-confirmations instead of 2s blocks.
# Since Base's Azul upgrade (May 2026) the public flashblocks websocket no longer carries logs, so the
# bot subscribes to `pendingLogs` on a Flashblocks-aware RPC websocket instead (base/node-reth nodes;
# Base's public one is wss://mainnet-preconf.base.org, or use your provider's flashblocks endpoint).
FLASHBLOCKS_RPC_WS=
# Raw flashblocks stream (wss://mainnet.flashblocks.base.org/ws). Only useful if it carries receipts.
FLASHBLOCKS_WS=
# Simulate against pre-confirmed ("pending") state. Defaults to on when either feed is set; RPC_URL
# must then be Flashblocks-aware too (e.g. https://mainnet-preconf.base.org), or "pending" lags the feed.
SIMULATE_PENDING=
# Advanced: skip the pre-send eth_call and trust the local quote (which reproduces every supported
# pool type exactly, given up-to-date state). Saves a round-trip per trade; a lost race or stale
# state then costs a reverted tx's gas (never principal: the executor still reverts unprofitable trades).
SKIP_SIMULATION=false

# ---- Concentrated liquidity ------------------------------------------------
# Load initialized ticks covering at least this % price move each way (bigger = more RPC reads).
CL_RANGE_PCT=25
# Comma-separated Uniswap V4 hook contracts whose pools may be traded. Hookless pools are always
# allowed; only list hooks you have audited (hooks can take fees or change swap amounts).
V4_HOOKS=

# ---- Discovery --------------------------------------------------------------
# Scan this many recent blocks (~2s each) of swaps to find active long-tail tokens. 0 disables.
DISCOVER_BLOCKS=900
MAX_SPOKES=300
# Comma-separated token addresses to always track.
EXTRA_TOKENS=
# Comma-separated DEX names to skip: uniswap-v2, sushiswap-v2, pancakeswap-v2, baseswap, aerodrome,
# uniswap-v3, sushiswap-v3, pancakeswap-v3, aerodrome-slipstream, uniswap-v4
DISABLE_DEXES=

# ---- Plumbing ---------------------------------------------------------------
RESYNC_EVERY_BLOCKS=150
POLL_MS=200
LOG_LEVEL=info
TRADE_LOG=logs/trades.jsonl
